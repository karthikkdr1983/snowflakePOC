{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Snowflake.Data": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Snowflake": {
    "Account": "",
    "Host": "",
    "User": "TIMEWISE_SVC",
    "Role": "TIMEWISE_API_ROLE",
    "Warehouse": "TIMEWISE_WH",
    "Database": "TIMEWISE_POC",
    "Schema": "API",
    "PrivateKeyPath": "../../keys/rsa_key.p8",
    "PrivateKeyPassphrase": "",
    "QueryTagPrefix": "timewise-api",
    "CommandTimeoutSeconds": 30
  },
  "Auth": {
    "Mode": "TestHeader"
  },
  "Cache": {
    "TtlSeconds": 120
  },
  "Resilience": {
    "AttemptTimeoutSeconds": 15,
    "MaxRetries": 2
  }
}
